# Aeon Intelligence - AI provider config for live (non-demo) AI Predictions and Daily Brief.
#
# Nothing else in this app needs a key: real news, sentiment, crypto, and SEC
# Form 4 insider trading data all work with zero configuration. Only the AI
# Predictions and Daily Brief tabs need at least one key below to run live
# instead of showing clearly-labeled demo/illustrative content.
#
# Free-tier providers, tried in this order (first configured key wins per call,
# falls through to the next on failure):

# Groq - free tier, generous rate limits. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Gemini - free tier. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional - only if you want to use a paid OpenAI key instead/as well.
OPENAI_API_KEY=

# Optional per-provider model overrides (defaults are already free-tier friendly).
# AI_MODEL_GROQ=llama-3.3-70b-versatile
# AI_MODEL_GEMINI=gemini-2.0-flash
# AI_MODEL_OPENAI=gpt-4o-mini

# Optional - free tier (800 requests/day, no cost, no card). Used only as a fallback
# for the AI Predictions "historical backtest" section, when Yahoo Finance rate-limits
# historical daily-price lookups (Yahoo needs no key and is tried first).
# Get a key at https://twelvedata.com/pricing (Basic/free plan).
TWELVE_DATA_API_KEY=

